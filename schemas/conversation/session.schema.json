{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-mate.local/schemas/conversation/session.schema.json",
  "title": "Session",
  "type": "object",
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "status": { "enum": ["draft", "planning", "ready_to_run", "running", "waiting_human", "completed", "failed", "cancelled"] },
    "created_by": { "type": "string" },
    "created_at": { "$ref": "../common/timestamps.schema.json#/$defs/dateTime" },
    "updated_at": { "$ref": "../common/timestamps.schema.json#/$defs/dateTime" },
    "active_run_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "archived": { "type": "boolean" },
    "hidden": { "type": "boolean" },
    "metadata": { "type": "object" }
  },
  "required": ["session_id", "workspace_id", "title", "status", "created_by", "created_at", "updated_at", "active_run_ids", "archived", "hidden", "metadata"],
  "additionalProperties": true
}
