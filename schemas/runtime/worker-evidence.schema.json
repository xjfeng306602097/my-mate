{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-mate.local/schemas/runtime/worker-evidence.schema.json",
  "title": "Worker Evidence",
  "type": "object",
  "$defs": {
    "moneyAmount": {
      "type": "object",
      "properties": {
        "currency": { "type": "string", "minLength": 3 },
        "amount_decimal": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$" }
      },
      "required": ["currency", "amount_decimal"],
      "additionalProperties": false
    },
    "estimatedMoneyAmount": {
      "type": "object",
      "properties": {
        "currency": { "type": "string", "minLength": 3 },
        "amount_decimal": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$" },
        "catalog_id": { "type": "string", "minLength": 1 },
        "catalog_version": { "type": "string", "minLength": 1 }
      },
      "required": ["currency", "amount_decimal", "catalog_id", "catalog_version"],
      "additionalProperties": false
    },
    "usageSummary": {
      "type": "object",
      "properties": {
        "availability": { "type": "string", "enum": ["available", "partial", "unavailable"] },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_read_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_write_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "turn_count": { "type": ["integer", "null"], "minimum": 0 },
        "provider_reported_cost": {
          "anyOf": [{ "$ref": "#/$defs/moneyAmount" }, { "type": "null" }]
        },
        "estimated_cost": {
          "anyOf": [{ "$ref": "#/$defs/estimatedMoneyAmount" }, { "type": "null" }]
        }
      },
      "required": [
        "availability", "input_tokens", "output_tokens", "cache_read_tokens",
        "cache_write_tokens", "reasoning_tokens", "total_tokens", "duration_ms",
        "turn_count", "provider_reported_cost", "estimated_cost"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "evidence_schema_version": { "type": "integer", "enum": [1, 2] },
    "evidence_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "node_run_id": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "worker_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "kind": {
      "type": "string",
      "enum": [
        "prompt", "model_turn", "model_text", "thinking", "tool_call", "tool_result",
        "handoff", "artifact_ref", "error", "usage", "log"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "native_event_id": { "type": ["string", "null"] },
        "synthetic": { "type": "boolean" }
      },
      "required": ["provider", "model", "native_event_id", "synthetic"],
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "span_id": { "type": "string", "minLength": 1 },
        "parent_span_id": { "type": ["string", "null"] },
        "tool_call_id": { "type": ["string", "null"] }
      },
      "required": ["trace_id", "span_id", "parent_span_id", "tool_call_id"],
      "additionalProperties": false
    },
    "summary": { "type": "string" },
    "input_ref": { "type": ["string", "null"] },
    "output_ref": { "type": ["string", "null"] },
    "storage_uri": { "type": ["string", "null"] },
    "inline_payload": {},
    "usage": {
      "anyOf": [{ "$ref": "#/$defs/usageSummary" }, { "type": "null" }]
    },
    "redaction_status": { "type": "string", "enum": ["not_required", "redacted", "blocked"] },
    "created_at": { "$ref": "../common/timestamps.schema.json#/$defs/dateTime" }
  },
  "required": [
    "evidence_schema_version", "evidence_id", "run_id", "node_run_id", "job_id",
    "worker_id", "kind", "source", "trace", "summary", "input_ref", "output_ref",
    "storage_uri", "inline_payload", "usage", "redaction_status", "created_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "evidence_schema_version": { "const": 2 } },
        "required": ["evidence_schema_version"]
      },
      "then": { "required": ["sequence"] }
    }
  ],
  "additionalProperties": false
}
