{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-mate.local/schemas/orchestration/dag-definition.schema.json",
  "title": "DAG Definition Revision",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "definition_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "source": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["template", "model", "manual"] },
        "template_id": { "type": ["string", "null"] },
        "message_id": { "type": ["string", "null"] }
      },
      "required": ["kind", "template_id", "message_id"],
      "additionalProperties": false
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 32000 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/node" }
    },
    "state_schema": { "type": "object" },
    "initial_state": { "type": "object" },
    "policy": { "type": "object" },
    "metadata": { "type": "object" },
    "created_at": { "$ref": "../common/timestamps.schema.json#/$defs/dateTime" }
  },
  "required": ["schema_version", "definition_id", "revision", "source", "title", "objective", "nodes", "policy", "metadata", "created_at"],
  "additionalProperties": false,
  "$defs": {
    "agentSelector": {
      "type": "object",
      "properties": {
        "agent_id": { "type": ["string", "null"] },
        "agent_version": { "type": ["integer", "null"], "minimum": 1 },
        "role": { "enum": ["orchestrator", "supervisor", "worker", "reviewer", "specialist", null] },
        "capability_tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "required": ["agent_id", "agent_version", "role", "capability_tags"],
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "operator": { "enum": ["exists", "truthy", "equals", "not_equals", "contains"] },
        "value": {}
      },
      "required": ["path", "operator"],
      "additionalProperties": false
    },
    "stateMapping": {
      "type": "object",
      "properties": {
        "source_path": { "type": "string", "minLength": 1 },
        "target_path": { "type": "string", "minLength": 1 },
        "reducer": { "enum": ["replace", "merge", "append"] }
      },
      "required": ["source_path", "target_path", "reducer"],
      "additionalProperties": false
    },
    "humanGate": {
      "type": "object",
      "properties": {
        "gate_type": { "enum": ["approval", "input"] },
        "prompt": { "type": "string", "minLength": 1 },
        "input_schema": { "type": "object" },
        "auto_resume": { "type": "boolean" }
      },
      "required": ["gate_type", "prompt", "input_schema", "auto_resume"],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["agent_task", "reviewer", "human_gate", "condition", "fanout", "combine", "end"] },
        "objective": { "type": "string" },
        "agent_selector": { "oneOf": [{ "$ref": "#/$defs/agentSelector" }, { "type": "null" }] },
        "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "join_policy": { "enum": ["all", "any", "quorum"] },
        "join_quorum": { "type": ["integer", "null"], "minimum": 1 },
        "condition": { "oneOf": [{ "$ref": "#/$defs/condition" }, { "type": "null" }] },
        "state_input": { "type": "object", "additionalProperties": { "type": "string" } },
        "state_output": { "type": "array", "items": { "$ref": "#/$defs/stateMapping" } },
        "human_gate": { "oneOf": [{ "$ref": "#/$defs/humanGate" }, { "type": "null" }] },
        "retry_policy": {
          "type": "object",
          "properties": {
            "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
            "backoff_seconds": { "type": "integer", "minimum": 0, "maximum": 300 }
          },
          "required": ["max_attempts", "backoff_seconds"],
          "additionalProperties": false
        },
        "allowed_tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "allowed_skills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "input_contract": { "type": "object" },
        "output_contract": { "type": "object" },
        "autonomy_mode": { "enum": ["review_first", "assisted", "autopilot"] },
        "max_tool_rounds": { "type": ["integer", "null"], "minimum": 1 },
        "max_runtime_seconds": { "type": ["integer", "null"], "minimum": 30 },
        "reviewer_node_id": { "type": ["string", "null"] },
        "metadata": { "type": "object" }
      },
      "required": ["node_id", "name", "kind", "objective", "agent_selector", "depends_on", "retry_policy", "allowed_tools", "allowed_skills", "input_contract", "output_contract", "autonomy_mode", "max_tool_rounds", "max_runtime_seconds", "reviewer_node_id", "metadata"],
      "additionalProperties": false
    }
  }
}
