{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-mate.local/schemas/agent/agent-binding-snapshot.schema.json",
  "title": "Agent Binding Snapshot",
  "type": "object",
  "properties": {
    "schema_version": { "const": 2 },
    "binding_id": { "type": "string", "minLength": 1 },
    "binding_mode": { "enum": ["pinned", "follow_latest"] },
    "agent_id": { "type": "string", "minLength": 1 },
    "agent_version": { "type": "integer", "minimum": 1 },
    "agent_name": { "type": "string", "minLength": 1 },
    "agent_role": { "enum": ["orchestrator", "supervisor", "worker", "reviewer", "specialist"] },
    "responsibility": { "type": "string" },
    "provider_id": { "type": "string" },
    "provider_connection_id": { "type": "string" },
    "connection_revision": { "type": "string" },
    "model_deployment_id": { "type": "string" },
    "model": { "type": "string" },
    "model_routing_policy": { "type": "object" },
    "system_prompt": { "type": "string" },
    "tool_policy": { "type": "object" },
    "skill_policy": { "type": "object" },
    "capability_policy": { "type": "object" },
    "memory_policy": { "type": "object" },
    "context_policy": { "type": "object" },
    "runtime_policy": { "type": "object" },
    "workspace_policy": { "type": "object" },
    "autonomy_ceiling": { "enum": ["review_first", "assisted", "autopilot"] },
    "artifact_policy": { "type": "object" },
    "delivery_policy": { "type": "object" },
    "snapshot_digest": { "type": "string", "minLength": 1 },
    "created_at": { "$ref": "../common/timestamps.schema.json#/$defs/dateTime" }
  },
  "required": [
    "schema_version", "binding_id", "binding_mode", "agent_id", "agent_version", "agent_name", "agent_role",
    "provider_id", "provider_connection_id", "connection_revision", "model_deployment_id", "model", "system_prompt",
    "tool_policy", "skill_policy", "memory_policy", "context_policy", "runtime_policy", "workspace_policy",
    "autonomy_ceiling", "artifact_policy", "delivery_policy", "snapshot_digest", "created_at"
  ],
  "additionalProperties": false
}
