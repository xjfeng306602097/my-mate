{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-mate.local/schemas/workflow/run-route.schema.json",
  "title": "Run Route Snapshot",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "route_id": { "type": "string", "minLength": 1 },
    "source_kind": {
      "type": "string",
      "enum": ["session_plan", "proposal", "direct_template", "rerun", "legacy"]
    },
    "session_id": { "type": ["string", "null"] },
    "proposal_id": { "type": ["string", "null"] },
    "plan_revision": { "type": ["integer", "null"], "minimum": 1 },
    "plan_option": {
      "type": ["string", "null"],
      "enum": ["primary", "alternative", null]
    },
    "source_run_id": { "type": ["string", "null"] },
    "template_id": { "type": "string", "minLength": 1 },
    "template_version": { "type": "integer", "minimum": 1 },
    "template_name": { "type": "string", "minLength": 1 },
    "node_count": { "type": "integer", "minimum": 0 },
    "edge_count": { "type": "integer", "minimum": 0 },
    "work_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 },
          "node_run_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "identity_source": {
            "type": "string",
            "enum": ["declared", "compiler_default", "legacy_inferred"]
          }
        },
        "required": ["key", "label", "order", "node_run_ids", "identity_source"],
        "additionalProperties": false
      }
    },
    "created_at": {
      "$ref": "../common/timestamps.schema.json#/$defs/dateTime"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "route_id",
    "source_kind",
    "session_id",
    "proposal_id",
    "plan_revision",
    "plan_option",
    "source_run_id",
    "template_id",
    "template_version",
    "template_name",
    "node_count",
    "edge_count",
    "work_packages",
    "created_at"
  ],
  "additionalProperties": false
}
