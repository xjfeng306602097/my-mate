{
  "name": "@my-mate/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm --prefix ../../packages/shared-types run build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts",
    "precheck": "npm --prefix ../../packages/shared-types run build",
    "check": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm --prefix ../../packages/shared-types run build",
    "test": "node --import tsx --test test/all.test.ts",
    "storage:export": "tsx src/storage-snapshot-cli.ts export",
    "storage:import": "tsx src/storage-snapshot-cli.ts import"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@my-mate/shared-types": "file:../../packages/shared-types",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "express": "^4.21.2",
    "fflate": "^0.8.2",
    "linkedom": "^0.18.12",
    "undici": "^6.27.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
