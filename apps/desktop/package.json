{
  "name": "@my-mate/desktop",
  "version": "0.1.0",
  "description": "My Mate local-first AI agent desktop application",
  "author": "My Mate contributors",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "pack:dir": "node node_modules/electron-builder/cli.js --dir --win --x64 --config.win.signAndEditExecutable=false",
    "dist:win": "node scripts/build-windows.cjs",
    "smoke:browser": "electron scripts/browser-capability-smoke.cjs",
    "smoke:browser:user": "electron scripts/browser-user-smoke.cjs",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check scripts/build-windows.cjs && node --check src/service-supervisor.cjs && node --check src/runtime-provisioner.cjs && node --check src/notification-host.cjs && node --check src/workspace-capability.cjs && node --check src/workspace-preview.cjs && node --check src/application-capability.cjs && node --check src/browser-capability.cjs && node --test test"
  },
  "dependencies": {
    "electron-updater": "6.6.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.mymate.desktop",
    "productName": "My Mate",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "xjfeng306602097",
        "repo": "my-mate"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "My-Mate-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "My Mate"
    }
  }
}
